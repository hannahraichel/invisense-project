<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Topbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="2dp"
        app:title="InviSense"
        app:titleTextColor="@color/text_primary"
        app:subtitle="Invigilator Dashboard"
        app:subtitleTextColor="@color/text_secondary" />

    <!-- Thin divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <!-- ── ACTIVE EXAM PANEL ── -->
                <LinearLayout
                    android:id="@+id/layoutExam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Exam info card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <!-- Status indicator badge -->
                            <TextView
                                android:id="@+id/tvStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:background="@color/surface_variant"
                                android:textColor="@color/text_primary"
                                android:layout_marginBottom="12dp" />

                            <TextView
                                android:id="@+id/tvSubject"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:id="@+id/tvHall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="14dp" />

                            <TextView
                                android:id="@+id/tvPresent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary" />

                            <TextView
                                android:id="@+id/tvScanWindow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="10dp"
                                android:background="@color/warning_bg"
                                android:textColor="@color/warning"
                                android:textSize="12.5sp"
                                android:layout_marginTop="10dp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Primary Action: Scan QR Code -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScan"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Scan QR Code"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/on_primary"
                        app:cornerRadius="10dp"
                        app:backgroundTint="@color/primary"
                        android:layout_marginBottom="10dp" />

                    <!-- Secondary Action: View Roster -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRoster"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="View Student Roster"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:cornerRadius="10dp"
                        app:backgroundTint="@color/surface"
                        app:strokeColor="@color/border"
                        app:strokeWidth="1dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Action: Raise Alert -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAlert"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Raise Incident Alert"
                        android:textColor="@color/danger"
                        android:textSize="14sp"
                        app:cornerRadius="10dp"
                        app:backgroundTint="@color/surface"
                        app:strokeColor="@color/border"
                        app:strokeWidth="1dp"
                        android:layout_marginBottom="16dp" />

                </LinearLayout>

                <!-- ── NO EXAM PANEL ── -->
                <LinearLayout
                    android:id="@+id/layoutNoExam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Active Exam"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvNoExamMsg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:text="Scanning opens automatically\n3 hours before your assigned exam." />
                </LinearLayout>

                <!-- ── MY FLAGGED INCIDENTS HISTORY ── -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAlertHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="My Flagged Incidents"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Incidents you reported during this session"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="14dp" />

                        <!-- Container for dynamic alert items -->
                        <LinearLayout
                            android:id="@+id/layoutAlertsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- Empty state when no alerts -->
                        <TextView
                            android:id="@+id/tvNoAlerts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="16dp"
                            android:text="No incidents flagged yet."
                            android:textColor="@color/muted"
                            android:textSize="13sp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
