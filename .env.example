# Copy this file to .env and fill in real values before running the project.

# Set to False in production
DEBUG=True

# Generate a fresh key for production: https://djecrety.ir/
SECRET_KEY=django-insecure-change-this-in-production

# Comma-separated list of hostnames allowed to serve this app in production
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of trusted origins for CSRF when serving over HTTPS
# CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Leave unset to use local SQLite (fine for quick testing only).
#
# For Supabase: Project → Connect → copy the "Session pooler" URI (Django
# works best with this one, not the Transaction pooler), then swap in your
# database password. It looks like this:
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# SSL is enforced automatically (see settings.py) — you don't need to add
# ?sslmode=require yourself.

TIME_ZONE=UTC
